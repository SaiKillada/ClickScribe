{
  "manifest_version": 3,
  "name": "ClickScribe",
  "version": "1.0.0",
  "description": "Record a screenshot on every click, then export the whole session as a Word document.",
  "permissions": ["activeTab", "tabs", "storage", "downloads", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClickScribe"
  }
}
